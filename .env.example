[TEMPLATE]
DATABASE_URL=postgresql://user:password@localhost:5432/nl_to_sql
API_KEY=change-me-before-deploy
GROQ_API_KEY=
LLM_MODEL=llama-3.1-70b-versatile
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
STATEMENT_TIMEOUT_MS=15000
# Optional: Postgres-only plan-cost guard; queries whose EXPLAIN estimate
# exceeds this are rejected before execution. <= 0 disables.
# EXPLAIN_COST_LIMIT=10000000
# Optional: comma-separated extra API keys; each valid key gets its own
# 30/min rate-limit bucket. Empty = only API_KEY is accepted.
# API_KEYS=team-key-1,team-key-2
# Optional: rate limit for POST /query (slowapi string, read at startup)
# QUERY_RATE_LIMIT=30/minute
# Optional: shared rate-limit storage across workers; falls back to in-memory
# buckets if unset or unreachable at startup.
# REDIS_URL=redis://localhost:6379/0
